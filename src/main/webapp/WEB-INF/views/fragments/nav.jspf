<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="${pageContext.request.contextPath}/menu">在线订餐系统</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a data-testid="nav-menu" class="nav-link" href="${pageContext.request.contextPath}/menu">菜单</a></li>
                <li class="nav-item"><a data-testid="nav-cart" class="nav-link" href="${pageContext.request.contextPath}/cart">购物车</a></li>
                <li class="nav-item"><a data-testid="nav-orders" class="nav-link" href="${pageContext.request.contextPath}/orders">我的订单</a></li>
                <c:if test="${currentRole == 'ADMIN'}">
                    <li class="nav-item"><a data-testid="nav-admin-menu" class="nav-link" href="${pageContext.request.contextPath}/admin/menu">后台菜品</a></li>
                    <li class="nav-item"><a data-testid="nav-admin-orders" class="nav-link" href="${pageContext.request.contextPath}/admin/orders">后台订单</a></li>
                </c:if>
            </ul>
            <span data-testid="nav-current-user" class="navbar-text me-3">当前用户：${currentUsername}</span>
            <button data-testid="logout-btn" class="btn btn-outline-light btn-sm" id="logoutBtn">退出</button>
        </div>
    </div>
</nav>
<script>
    (function bindLogout() {
        const btn = document.getElementById('logoutBtn');
        if (!btn) {
            return;
        }
        btn.addEventListener('click', async () => {
            const ctx = '${pageContext.request.contextPath}';
            await fetch(`\${ctx}/api/auth/logout`, { method: 'POST', credentials: 'same-origin' });
            window.location.href = `\${ctx}/login`;
        });
    })();
</script>
